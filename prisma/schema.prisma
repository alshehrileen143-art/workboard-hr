// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}
model Employee {
  id                    String              @id @default(cuid())
  fullName              String
  email                 String              @unique
  jobTitle              String
  department            String
  hireDate              DateTime
  createdAt             DateTime            @default(now())
  annualLeaveBalance    Int                 @default(30)
  leaveBalanceNote      String?
  status                EmployeeStatus      @default(ACTIVE)
  nationalId            String?
  iqamaExpiryDate       DateTime?           @db.Date
  phoneNumber           String?
  emergencyContactName  String?
  emergencyContactPhone String?
  user                  User?
  attendances           Attendance[]
  managerId             String?
  manager               Employee?           @relation("EmployeeManager", fields: [managerId], references: [id])
  directReports         Employee[]          @relation("EmployeeManager")
  assignedTasks         Task[]              @relation("TaskAssignee")
  createdTasks          Task[]              @relation("TaskCreator")
  complaintsAsEmployee  ComplaintToHR[]     @relation("ComplaintEmployee")
  complaintsAsManager   ComplaintToHR[]     @relation("ComplaintManager")
  leaveRequests         LeaveRequest[]
  auditLogs             EmployeeAuditLog[]
}

enum EmployeeStatus {
  ACTIVE
  ARCHIVED
}

enum Role {
  HR
  MANAGER
  EMPLOYEE
}

enum LeaveType {
  ANNUAL
  SICK
  EMERGENCY
  PERMISSION
  UNAUTHORIZED_ABSENCE
}

model User {
  id                String             @id @default(cuid())
  email             String             @unique
  password          String
  role              Role               @default(EMPLOYEE)
  isActive          Boolean            @default(true)
  employeeId        String?            @unique
  employee          Employee?          @relation(fields: [employeeId], references: [id])
  createdAt         DateTime           @default(now())
  employeeAuditLogs EmployeeAuditLog[]
}

enum AttendanceSource {
  SELF
  HR
  IMPORT
}

model Attendance {
  id         String           @id @default(cuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id])
  date       DateTime         @db.Date
  checkIn    DateTime?
  checkOut   DateTime?
  source     AttendanceSource @default(SELF)
  createdAt  DateTime         @default(now())

  @@unique([employeeId, date])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

model Task {
  id          String          @id @default(cuid())
  title       String
  description String?
  deadline    DateTime
  status      TaskStatus      @default(PENDING)
  employeeId  String
  employee    Employee        @relation("TaskAssignee", fields: [employeeId], references: [id])
  managerId   String
  manager     Employee        @relation("TaskCreator", fields: [managerId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  complaints  ComplaintToHR[]
}

enum ComplaintStatus {
  OPEN
  RESOLVED
}

model ComplaintToHR {
  id         String          @id @default(cuid())
  taskId     String
  task       Task            @relation(fields: [taskId], references: [id])
  employeeId String
  employee   Employee        @relation("ComplaintEmployee", fields: [employeeId], references: [id])
  managerId  String
  manager    Employee        @relation("ComplaintManager", fields: [managerId], references: [id])
  reason     String
  status     ComplaintStatus @default(OPEN)
  createdAt  DateTime        @default(now())
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id           String             @id @default(cuid())
  employeeId   String
  employee     Employee           @relation(fields: [employeeId], references: [id])
  type         LeaveType
  startDate    DateTime?          @db.Date
  endDate      DateTime?          @db.Date
  requestDate  DateTime?          @db.Date
  hours        Float?
  reason       String
  managerStatus LeaveRequestStatus @default(PENDING)
  managerNote  String?
  hrStatus     LeaveRequestStatus @default(PENDING)
  hrNote       String?
  createdAt    DateTime           @default(now())
}

model EmployeeAuditLog {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  changedByUserId String
  changedByUser   User     @relation(fields: [changedByUserId], references: [id])
  fieldChanged    String
  oldValue        String?
  newValue        String?
  changedAt       DateTime @default(now())
}

model PolicyChunk {
  id           String                       @id @default(cuid())
  content      String
  chapterTitle String?
  articleTitle String?
  embedding    Unsupported("vector(1536)")?
  createdAt    DateTime                     @default(now())
}